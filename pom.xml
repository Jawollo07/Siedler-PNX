<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Project -->
    <groupId>de.jawollo07</groupId>
    <artifactId>siedler</artifactId>
    <version>8.0.1</version>
    <packaging>jar</packaging>

    <name>Siedler</name>
    <description>Siedler 8.0.1 - PowerNukkitX Plugin</description>

    <!-- Java -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- Repositories -->
    <repositories>

        <!-- Maven Central -->
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2/</url>
        </repository>

        <!-- PowerNukkitX -->
        <repository>
            <id>PowerNukkitX-releases</id>
            <name>PowerNukkitX Repository</name>
            <url>https://repo.powernukkitx.org/releases</url>
        </repository>

        <!-- OpenCollab Releases -->
        <repository>
            <id>opencollab-releases</id>
            <name>OpenCollab Releases</name>
            <url>https://repo.opencollab.dev/maven-releases</url>
        </repository>

        <!-- OpenCollab Snapshots -->
        <repository>
            <id>opencollab-snapshots</id>
            <name>OpenCollab Snapshots</name>
            <url>https://repo.opencollab.dev/maven-snapshots</url>
        </repository>

        <!-- JitPack -->
        <repository>
            <id>jitpack.io</id>
            <url>https://www.jitpack.io</url>
        </repository>

    </repositories>

    <!-- Dependencies -->
    <dependencies>

        <!--
            PowerNukkitX Server API.

            Wird vom Server bereitgestellt und deshalb NICHT
            in das Plugin-JAR gepackt.
        -->
        <dependency>
            <groupId>org.powernukkitx</groupId>
            <artifactId>server</artifactId>
            <version>3.0.5-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!--
            SQLite JDBC Driver.
        -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.50.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.5.10</version>
        </dependency>
    </dependencies>

    <!-- Build -->
    <build>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/java/de/jawollo07/siedler/storage</directory>
                <includes>
                    <include>init.sql</include>
                </includes>
                <targetPath>storage</targetPath>
            </resource>
        </resources>

        <plugins>

            <!-- Java Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>

                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!--
                Maven Shade

                Packt SQLite und andere normale Dependencies
                direkt in das finale Plugin-JAR.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>

                <executions>
                    <execution>

                        <id>shade</id>

                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>

                            <!--
                                Verhindert, dass Maven eine
                                dependency-reduced-pom.xml erzeugt.
                            -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!--
                                Wichtig für JDBC ServiceLoader.

                                Dadurch bleibt:
                                META-INF/services/java.sql.Driver
                                erhalten.
                            -->
                            <transformers>

                                <transformer implementation=
                                    "org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>

                            </transformers>

                            <!--
                                Entfernt Signaturdateien von
                                eingebetteten Libraries.
                            -->
                            <filters>

                                <filter>

                                    <artifact>*:*</artifact>

                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>

                                </filter>

                            </filters>

                        </configuration>

                    </execution>
                </executions>

            </plugin>

        </plugins>

    </build>

</project>
